FROM ubuntu:22.04

# Installa le librerie necessarie, incluse Pango e GDK
RUN apt-get update && apt-get install -y \
    build-essential pkg-config curl \
    libgtk-3-dev libayatana-appindicator3-dev \
    libglib2.0-dev libgdk-pixbuf2.0-dev \
    libpango1.0-dev \
    && rm -rf /var/lib/apt/lists/*

# Installa Rust
RUN curl https://sh.rustup.rs -sSf | bash -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Imposta directory di lavoro
WORKDIR /app/tray-icon

# Copia il progetto Rust
COPY tray-icon /app/tray-icon

# Copia le icone (opzionale)
COPY icons /app/icons

# Compila in release
RUN cargo build --release

# Estrai binario
CMD ["sh", "-c", "mkdir -p /output && cp /app/tray-icon/target/release/agent-tray /output/agent-tray && echo ✅ agent-tray copiato in /output"]
